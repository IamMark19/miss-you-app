# Copy these into your Vercel project's Settings -> Environment Variables.
# Do not commit a real .env file with actual values to git.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=paste-public-key-here
VAPID_PRIVATE_KEY=paste-private-key-here
VAPID_SUBJECT=mailto:you@example.com
